{
  "enabledPlugins": {
    "impeccable@impeccable": true
  },
  "includeCoAuthoredBy": false,
  "env": {
    "INSIDE_CLAUDE_CODE": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "420000",
    "BASH_MAX_TIMEOUT_MS": "420000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(git branch --show-current)\" != \"main\" ] || { echo 'Cannot modify files directly on main branch' >&2; exit 2; }",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
