# Runtime API/Compose configuration. See docs/operations/environment.md.
NODE_ENV=production
PORT=4101
WEB_PORT=4100
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=classora
POSTGRES_PASSWORD=
POSTGRES_DB=classora
CONTROL_DB_NAME=control_db
JWT_SECRET=
JWT_ACCESS_TTL=1h
ENABLE_SWAGGER=false
# Bootstrap-only values: remove them after owner creation; Compose does not pass them to the API.
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=
INITIAL_USER_NAME=
INITIAL_TENANT_SLUG=demo
TENANT_OWNER_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=

# Backup operations: keep R2 credentials in a root-owned host environment file, never in Git.
BACKUP_ROOT=/var/lib/classora/backups
BACKUP_LOCK_DIR=/run/lock/classora-backup
BACKUP_UPLOAD=0
BACKUP_LOCAL_RUNS=3
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PREFIX=classora-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
AWS_DEFAULT_REGION=auto
