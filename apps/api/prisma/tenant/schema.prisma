// Tenant-database schema, applied to every tenant database by
// `pnpm tenant:migrate` (prisma migrate deploy per tenant, see
// src/database/tenant-migrations.ts). Tenant data is queried at runtime
// through raw pg pools (TenantConnectionManager), so no Prisma client is
// generated from this schema.

datasource db {
  provider = "postgresql"
}

model Student {
  id                String                 @id @db.Char(26)
  tenantId          String                 @map("tenant_id") @db.Char(26)
  code              String
  fullName          String                 @map("full_name")
  phone             String?
  email             String?
  dateOfBirth       DateTime?              @map("date_of_birth") @db.Date
  status            String                 @default("ACTIVE")
  gender            String?
  address           String?
  school            String?
  source            String?
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  enrollments       Enrollment[]
  guardians         StudentGuardian[]
  tagAssignments    StudentTagAssignment[]
  notes             StudentNote[]
  attendanceRecords AttendanceRecord[]
  makeupEntitlements MakeupEntitlement[]
  makeupBookings MakeupBooking[]
  invoices          Invoice[]
  payments          Payment[]
  enrollmentPricing EnrollmentPricing[]
  enrollmentDiscounts EnrollmentDiscount[]

  @@unique([tenantId, id], map: "students_tenant_id_id_key")
  @@unique([tenantId, code], map: "students_tenant_id_code_key")
  @@index([tenantId, fullName, id], map: "students_tenant_id_full_name_id_idx")
  @@map("students")
}

model Guardian {
  id        String            @id @db.Char(26)
  tenantId  String            @map("tenant_id") @db.Char(26)
  fullName  String            @map("full_name")
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  students  StudentGuardian[]

  @@unique([tenantId, id], map: "guardians_tenant_id_id_key")
  @@index([tenantId, fullName, id], map: "guardians_tenant_id_full_name_id_idx")
  @@index([tenantId, phone, id], map: "guardians_tenant_id_phone_id_idx")
  @@index([tenantId, email, id], map: "guardians_tenant_id_email_id_idx")
  @@map("guardians")
}

model StudentGuardian {
  id               String   @id @db.Char(26)
  tenantId         String   @map("tenant_id") @db.Char(26)
  studentId        String   @map("student_id") @db.Char(26)
  guardianId       String   @map("guardian_id") @db.Char(26)
  relationship     String
  isPrimaryContact Boolean  @default(false) @map("is_primary_contact")
  isBillingContact Boolean  @default(false) @map("is_billing_contact")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  student          Student  @relation(fields: [tenantId, studentId], references: [tenantId, id])
  guardian         Guardian @relation(fields: [tenantId, guardianId], references: [tenantId, id])

  @@unique([tenantId, studentId, guardianId], map: "student_guardians_tenant_student_guardian_key")
  @@index([tenantId, studentId, isPrimaryContact, id], map: "student_guardians_tenant_student_primary_idx")
  @@index([tenantId, guardianId, id], map: "student_guardians_tenant_guardian_id_idx")
  @@map("student_guardians")
}

model StudentTag {
  id        String                 @id @db.Char(26)
  tenantId  String                 @map("tenant_id") @db.Char(26)
  name      String
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  students  StudentTagAssignment[]

  @@unique([tenantId, id], map: "student_tags_tenant_id_id_key")
  @@unique([tenantId, name], map: "student_tags_tenant_id_name_key")
  @@index([tenantId, name, id], map: "student_tags_tenant_id_name_id_idx")
  @@map("student_tags")
}

model StudentTagAssignment {
  id        String     @id @db.Char(26)
  tenantId  String     @map("tenant_id") @db.Char(26)
  studentId String     @map("student_id") @db.Char(26)
  tagId     String     @map("tag_id") @db.Char(26)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  student   Student    @relation(fields: [tenantId, studentId], references: [tenantId, id])
  tag       StudentTag @relation(fields: [tenantId, tagId], references: [tenantId, id])

  @@unique([tenantId, studentId, tagId], map: "student_tag_assignments_tenant_student_tag_key")
  @@index([tenantId, studentId, tagId], map: "student_tag_assignments_tenant_student_tag_idx")
  @@map("student_tag_assignments")
}

model StudentNote {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  studentId  String   @map("student_id") @db.Char(26)
  content    String
  authorId   String?  @map("author_id") @db.Char(26)
  authorName String?  @map("author_name")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  student    Student  @relation(fields: [tenantId, studentId], references: [tenantId, id])

  @@index([tenantId, studentId, createdAt, id], map: "student_notes_tenant_student_created_id_idx")
  @@map("student_notes")
}

model Branch {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  code      String
  name      String
  address   String?
  phone     String?
  email     String?
  status    String   @default("ACTIVE")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  rooms      Room[]
  classes    Class[]
  teachers   TeacherBranch[]
  exclusions       ScheduleExclusion[]
  schedulePatterns SchedulePattern[]
  sessions         Session[]

  @@unique([tenantId, id], map: "branches_tenant_id_id_key")
  @@unique([tenantId, code], map: "branches_tenant_id_code_key")
  @@index([tenantId, name, id], map: "branches_tenant_id_name_id_idx")
  @@map("branches")
}

model Room {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  branchId  String   @map("branch_id") @db.Char(26)
  code      String
  name      String
  capacity  Int?
  status    String   @default("ACTIVE")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  branch           Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id])
  classes          Class[]
  schedulePatterns SchedulePattern[]
  sessions         Session[]

  @@unique([tenantId, id], map: "rooms_tenant_id_id_key")
  @@unique([tenantId, branchId, code], map: "rooms_tenant_id_branch_id_code_key")
  @@index([tenantId, branchId, name, id], map: "rooms_tenant_id_branch_id_name_id_idx")
  @@map("rooms")
}

model Course {
  id          String        @id @db.Char(26)
  tenantId    String        @map("tenant_id") @db.Char(26)
  code        String
  name        String
  description String?
  status      String        @default("ACTIVE")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz
  classes     Class[]
  levels      CourseLevel[]

  @@unique([tenantId, id], map: "courses_tenant_id_id_key")
  @@unique([tenantId, code], map: "courses_tenant_id_code_key")
  @@index([tenantId, name, id], map: "courses_tenant_id_name_id_idx")
  @@map("courses")
}

model CourseLevel {
  id           String   @id @db.Char(26)
  tenantId     String   @map("tenant_id") @db.Char(26)
  courseId     String   @map("course_id") @db.Char(26)
  code         String
  name         String
  displayOrder Int      @default(0) @map("display_order")
  description  String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz
  course       Course   @relation(fields: [tenantId, courseId], references: [tenantId, id])
  classes      Class[]

  @@unique([tenantId, id], map: "course_levels_tenant_id_id_key")
  @@unique([tenantId, courseId, code], map: "course_levels_tenant_id_course_id_code_key")
  @@index([tenantId, courseId, displayOrder, id], map: "course_levels_tenant_id_course_id_order_id_idx")
  @@map("course_levels")
}

model Class {
  id                 String              @id @db.Char(26)
  tenantId           String              @map("tenant_id") @db.Char(26)
  courseId           String?             @map("course_id") @db.Char(26)
  branchId           String?             @map("branch_id") @db.Char(26)
  courseLevelId      String?             @map("course_level_id") @db.Char(26)
  defaultRoomId      String?             @map("default_room_id") @db.Char(26)
  primaryTeacherId   String?             @map("primary_teacher_id") @db.Char(26)
  capacity           Int?
  startDate          DateTime?           @map("start_date") @db.Date
  expectedEndDate    DateTime?           @map("expected_end_date") @db.Date
  code               String
  name               String
  description        String?
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  course             Course?             @relation(fields: [tenantId, courseId], references: [tenantId, id])
  branch             Branch?             @relation(fields: [tenantId, branchId], references: [tenantId, id])
  courseLevel        CourseLevel?        @relation(fields: [tenantId, courseLevelId], references: [tenantId, id])
  defaultRoom        Room?               @relation(fields: [tenantId, defaultRoomId], references: [tenantId, id])
  primaryTeacher     Teacher?            @relation(fields: [tenantId, primaryTeacherId], references: [tenantId, id])
  enrollments        Enrollment[]
  schedulePatterns   SchedulePattern[]
  sessions           Session[]

  @@unique([tenantId, id], map: "classes_tenant_id_id_key")
  @@unique([tenantId, code], map: "classes_tenant_id_code_key")
  @@index([tenantId, name, id], map: "classes_tenant_id_name_id_idx")
  @@index([tenantId, courseId, name, id], map: "classes_tenant_id_course_id_name_id_idx")
  @@index([tenantId, branchId, status, name, id], map: "classes_tenant_id_branch_id_status_name_id_idx")
  @@map("classes")
}

model Teacher {
  id                 String              @id @db.Char(26)
  tenantId           String              @map("tenant_id") @db.Char(26)
  code               String
  name               String
  phone              String?
  email              String?
  note               String?
  specialties        String[]            @default([])
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  schedulePatterns   SchedulePattern[]
  sessions           Session[]
  branches           TeacherBranch[]
  classes            Class[]

  @@unique([tenantId, id], map: "teachers_tenant_id_id_key")
  @@unique([tenantId, code], map: "teachers_tenant_id_code_key")
  @@index([tenantId, name, id], map: "teachers_tenant_id_name_id_idx")
  @@map("teachers")
}

model TeacherBranch {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  teacherId String   @map("teacher_id") @db.Char(26)
  branchId  String   @map("branch_id") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  teacher   Teacher  @relation(fields: [tenantId, teacherId], references: [tenantId, id])
  branch    Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@unique([tenantId, teacherId, branchId], map: "teacher_branches_tenant_teacher_branch_key")
  @@index([tenantId, branchId, teacherId], map: "teacher_branches_tenant_branch_teacher_idx")
  @@map("teacher_branches")
}

model Enrollment {
  id                 String            @id @db.Char(26)
  tenantId           String            @map("tenant_id") @db.Char(26)
  studentId          String            @map("student_id") @db.Char(26)
  classId            String            @map("class_id") @db.Char(26)
  status             String            @default("PENDING")
  enrolledAt         DateTime          @default(now()) @map("enrolled_at") @db.Timestamptz
  startedAt          DateTime?         @map("started_at") @db.Timestamptz
  endedAt            DateTime?         @map("ended_at") @db.Timestamptz
  pauseStartedAt     DateTime?         @map("pause_started_at") @db.Timestamptz
  expectedEndDate    DateTime?         @map("expected_end_date") @db.Date
  sourceEnrollmentId String?           @map("source_enrollment_id") @db.Char(26)
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  student            Student           @relation(fields: [tenantId, studentId], references: [tenantId, id])
  class              Class             @relation(fields: [tenantId, classId], references: [tenantId, id])
  sourceEnrollment   Enrollment?       @relation("EnrollmentSource", fields: [tenantId, sourceEnrollmentId], references: [tenantId, id])
  derivedEnrollments Enrollment[]      @relation("EnrollmentSource")
  events             EnrollmentEvent[]
  attendanceRecords  AttendanceRecord[]
  makeupEntitlements MakeupEntitlement[]
  pricingPlanId     String?          @map("pricing_plan_id") @db.Char(26)
  pricingPlan       PricingPlan?     @relation(fields: [tenantId, pricingPlanId], references: [tenantId, id])
  invoiceItems      InvoiceItem[]
  invoices          Invoice[]
  enrollmentPricing EnrollmentPricing[]
  enrollmentDiscounts EnrollmentDiscount[]

  @@unique([tenantId, id], map: "enrollments_tenant_id_id_key")
  @@index([tenantId, classId, enrolledAt, id], map: "enrollments_tenant_id_class_id_enrolled_at_id_idx")
  @@index([tenantId, studentId, enrolledAt, id], map: "enrollments_tenant_student_dates_idx")
  @@map("enrollments")
}

model EnrollmentEvent {
  id               String     @id @db.Char(26)
  tenantId         String     @map("tenant_id") @db.Char(26)
  enrollmentId     String     @map("enrollment_id") @db.Char(26)
  type             String
  fromStatus       String?    @map("from_status")
  toStatus         String?    @map("to_status")
  fromClassId      String?    @map("from_class_id") @db.Char(26)
  toClassId        String?    @map("to_class_id") @db.Char(26)
  reason           String?
  metadata         Json?
  actorUserId      String?    @map("actor_user_id") @db.Char(26)
  actorMembershipId String?   @map("actor_membership_id") @db.Char(26)
  occurredAt       DateTime   @default(now()) @map("occurred_at") @db.Timestamptz
  enrollment       Enrollment @relation(fields: [tenantId, enrollmentId], references: [tenantId, id])

  @@index([tenantId, enrollmentId, occurredAt, id])
  @@index([tenantId, occurredAt, id])
  @@map("enrollment_events")
}

/// Active duplicates are prevented by the migration's partial unique index, which Prisma cannot model.
model SchedulePattern {
  id               String      @id @db.Char(26)
  tenantId         String      @map("tenant_id") @db.Char(26)
  classId          String      @map("class_id") @db.Char(26)
  teacherId        String      @map("teacher_id") @db.Char(26)
  branchId         String?     @map("branch_id") @db.Char(26)
  roomId           String?     @map("room_id") @db.Char(26)
  dayOfWeek        String      @map("day_of_week")
  startTime        DateTime    @map("start_time") @db.Time(0)
  endTime          DateTime    @map("end_time") @db.Time(0)
  effectiveFrom    DateTime?   @map("effective_from") @db.Date
  effectiveUntil   DateTime?   @map("effective_until") @db.Date
  legacyRoomSource String?     @map("legacy_room_source")
  status           String      @default("ACTIVE")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  class            Class       @relation(fields: [tenantId, classId], references: [tenantId, id])
  teacher          Teacher     @relation(fields: [tenantId, teacherId], references: [tenantId, id])
  branch           Branch?     @relation(fields: [tenantId, branchId], references: [tenantId, id])
  room             Room?       @relation(fields: [tenantId, roomId], references: [tenantId, id])
  sessions         Session[]
  @@unique([tenantId, id], map: "schedules_tenant_id_id_key")
  @@map("schedules")
}

/// Schedule/date uniqueness is enforced by the migration's partial unique index, which Prisma cannot model.
model Session {
  id          String             @id @db.Char(26)
  tenantId    String             @map("tenant_id") @db.Char(26)
  classId     String             @map("class_id") @db.Char(26)
  schedulePatternId String?       @map("schedule_pattern_id") @db.Char(26)
  roomId            String?       @map("room_id") @db.Char(26)
  teacherId         String?       @map("teacher_id") @db.Char(26)
  branchId          String?       @map("branch_id") @db.Char(26)
  sessionDate DateTime           @map("session_date") @db.Date
  startTime   DateTime           @map("start_time") @db.Time(0)
  endTime     DateTime           @map("end_time") @db.Time(0)
  status             String             @default("SCHEDULED")
  manualOverride     Boolean            @default(false) @map("manual_override")
  rescheduledFromId  String?            @map("rescheduled_from_id") @db.Char(26)
  cancellationReason String?            @map("cancellation_reason")
  rescheduleReason   String?            @map("reschedule_reason")
  sourceSessionDate  DateTime?          @map("source_session_date") @db.Date
  sourceStartTime    DateTime?          @map("source_start_time") @db.Time(0)
  sourceEndTime      DateTime?          @map("source_end_time") @db.Time(0)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  class       Class             @relation(fields: [tenantId, classId], references: [tenantId, id])
  pattern     SchedulePattern?  @relation(fields: [tenantId, schedulePatternId], references: [tenantId, id])
  teacher     Teacher?           @relation(fields: [tenantId, teacherId], references: [tenantId, id])
  branch      Branch?            @relation(fields: [tenantId, branchId], references: [tenantId, id])
  room        Room?              @relation(fields: [tenantId, roomId], references: [tenantId, id])
  rescheduledFrom Session?       @relation("SessionReschedule", fields: [tenantId, rescheduledFromId], references: [tenantId, id])
  replacements   Session[]        @relation("SessionReschedule")
  records     AttendanceRecord[]
  attendanceSheet AttendanceSheet?
  sourceMakeupEntitlements MakeupEntitlement[] @relation("MakeupSourceSession")
  destinationMakeupBookings MakeupBooking[] @relation("MakeupDestinationSession")

  @@index([tenantId, classId, sessionDate, id], map: "attendance_sessions_tenant_id_class_id_session_date_id_idx")
  @@unique([tenantId, id], map: "attendance_sessions_tenant_id_id_key")
  @@map("attendance_sessions")
}

model ScheduleExclusion {
  id        String   @id @db.Char(26)
  tenantId String   @map("tenant_id") @db.Char(26)
  date      DateTime @db.Date
  branchId  String?  @map("branch_id") @db.Char(26)
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  branch    Branch?  @relation(fields: [tenantId, branchId], references: [tenantId, id])

  /// Tenant-wide uniqueness uses the migration's functional COALESCE index.
  @@index([tenantId, date, branchId], map: "schedule_exclusions_tenant_date_idx")
  @@map("schedule_exclusions")
}

model AttendanceSheet {
  id             String   @id @db.Char(26)
  tenantId       String   @map("tenant_id") @db.Char(26)
  sessionId      String   @map("session_id") @db.Char(26)
  status         String   @default("OPEN")
  initializedAt  DateTime @default(now()) @map("initialized_at") @db.Timestamptz
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz
  lockedByUserId String? @map("locked_by_user_id") @db.Char(26)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  session        Session  @relation(fields: [tenantId, sessionId], references: [tenantId, id])

  @@unique([tenantId, id], map: "attendance_sheets_tenant_id_id_key")
  @@unique([tenantId, sessionId], map: "attendance_sheets_tenant_session_key")
  @@map("attendance_sheets")
}

model AttendanceRecord {
  id                  String            @id @db.Char(26)
  tenantId            String            @map("tenant_id") @db.Char(26)
  sessionId           String            @map("session_id") @db.Char(26)
  studentId           String            @map("student_id") @db.Char(26)
  enrollmentId        String?           @map("enrollment_id") @db.Char(26)
  status              String            @default("UNMARKED")
  note                String?
  source              String            @default("REGULAR")
  makeupBookingId     String?           @map("makeup_booking_id") @db.Char(26)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  session             Session           @relation(fields: [tenantId, sessionId], references: [tenantId, id])
  student             Student           @relation(fields: [tenantId, studentId], references: [tenantId, id])
  enrollment          Enrollment?       @relation(fields: [tenantId, enrollmentId], references: [tenantId, id])
  makeupBooking       MakeupBooking?    @relation(fields: [tenantId, makeupBookingId], references: [tenantId, id])
  corrections         AttendanceCorrection[]
  makeupEntitlement   MakeupEntitlement? @relation("MakeupSourceRecord")

  @@unique([tenantId, id], map: "attendance_records_tenant_id_id_key")
  @@unique([tenantId, sessionId, studentId], map: "attendance_records_session_student_key")
  @@index([tenantId, studentId, id], map: "attendance_records_tenant_id_student_id_id_idx")
  @@map("attendance_records")
}

model AttendanceCorrection {
  id                 String @id @db.Char(26)
  tenantId           String @map("tenant_id") @db.Char(26)
  attendanceRecordId String @map("attendance_record_id") @db.Char(26)
  beforeStatus       String @map("before_status")
  afterStatus        String @map("after_status")
  beforeNote         String? @map("before_note")
  afterNote          String? @map("after_note")
  reason             String
  actorUserId        String? @map("actor_user_id") @db.Char(26)
  actorMembershipId  String? @map("actor_membership_id") @db.Char(26)
  requestId          String? @map("request_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  record             AttendanceRecord @relation(fields: [tenantId, attendanceRecordId], references: [tenantId, id])

  @@unique([tenantId, id], map: "attendance_corrections_tenant_id_id_key")
  @@index([tenantId, attendanceRecordId, createdAt, id])
  @@map("attendance_corrections")
}

model MakeupEntitlement {
  id                     String @id @db.Char(26)
  tenantId               String @map("tenant_id") @db.Char(26)
  studentId              String @map("student_id") @db.Char(26)
  sourceAttendanceRecordId String @map("source_attendance_record_id") @db.Char(26)
  sourceSessionId        String @map("source_session_id") @db.Char(26)
  sourceEnrollmentId     String? @map("source_enrollment_id") @db.Char(26)
  status                 String @default("AVAILABLE")
  expiresAt              DateTime @map("expires_at") @db.Date
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  student                Student @relation(fields: [tenantId, studentId], references: [tenantId, id])
  sourceRecord           AttendanceRecord @relation("MakeupSourceRecord", fields: [tenantId, sourceAttendanceRecordId], references: [tenantId, id])
  sourceSession          Session @relation("MakeupSourceSession", fields: [tenantId, sourceSessionId], references: [tenantId, id])
  sourceEnrollment       Enrollment? @relation(fields: [tenantId, sourceEnrollmentId], references: [tenantId, id])
  bookings               MakeupBooking[]

  @@unique([tenantId, id], map: "makeup_entitlements_tenant_id_id_key")
  @@unique([tenantId, sourceAttendanceRecordId], map: "makeup_entitlements_source_key")
  @@index([tenantId, studentId, status, expiresAt, id])
  @@map("makeup_entitlements")
}

model MakeupBooking {
  id                   String @id @db.Char(26)
  tenantId             String @map("tenant_id") @db.Char(26)
  entitlementId        String @map("entitlement_id") @db.Char(26)
  studentId            String @map("student_id") @db.Char(26)
  destinationSessionId String @map("destination_session_id") @db.Char(26)
  status               String @default("BOOKED")
  bookedAt             DateTime @default(now()) @map("booked_at") @db.Timestamptz
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz
  usedAt               DateTime? @map("used_at") @db.Timestamptz
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  entitlement          MakeupEntitlement @relation(fields: [tenantId, entitlementId], references: [tenantId, id])
  student              Student @relation(fields: [tenantId, studentId], references: [tenantId, id])
  destinationSession   Session @relation("MakeupDestinationSession", fields: [tenantId, destinationSessionId], references: [tenantId, id])
  attendanceRecords    AttendanceRecord[]

  @@unique([tenantId, id], map: "makeup_bookings_tenant_id_id_key")
  @@index([tenantId, destinationSessionId, status, id])
  @@index([tenantId, studentId, status, bookedAt, id])
  @@map("makeup_bookings")
}

model PricingPlan {
  id            String        @id @db.Char(26)
  tenantId      String        @map("tenant_id") @db.Char(26)
  code          String
  name          String
  amountVnd     BigInt        @map("amount_vnd")
  billingPeriod String        @default("ONE_TIME") @map("billing_period")
  status        String        @default("ACTIVE")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  enrollments   Enrollment[]
  invoices      Invoice[]
  enrollmentPricing EnrollmentPricing[]

  @@unique([tenantId, id], map: "pricing_plans_tenant_id_key")
  @@unique([tenantId, code], map: "pricing_plans_tenant_code_key")
  @@index([tenantId, status, name, id])
  @@map("pricing_plans")
}

model Invoice {
  id             String         @id @db.Char(26)
  tenantId       String         @map("tenant_id") @db.Char(26)
  invoiceNumber  String?        @map("invoice_number")
  studentId      String         @map("student_id") @db.Char(26)
  enrollmentId   String?        @map("enrollment_id") @db.Char(26)
  pricingPlanId  String?        @map("pricing_plan_id") @db.Char(26)
  status         String         @default("DRAFT")
  issueDate      DateTime?      @map("issue_date") @db.Date
  dueDate        DateTime?      @map("due_date") @db.Date
  subtotalVnd    BigInt         @default(0) @map("subtotal_vnd")
  discountVnd    BigInt         @default(0) @map("discount_vnd")
  totalVnd       BigInt         @default(0) @map("total_vnd")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  voidedAt       DateTime?      @map("voided_at") @db.Timestamptz
  student        Student        @relation(fields: [tenantId, studentId], references: [tenantId, id])
  enrollment     Enrollment?    @relation(fields: [tenantId, enrollmentId], references: [tenantId, id])
  pricingPlan    PricingPlan?   @relation(fields: [tenantId, pricingPlanId], references: [tenantId, id])
  items          InvoiceItem[]
  payments       Payment[]
  creditNotes       CreditNote[]
  paymentAllocations PaymentAllocation[]
  statusHistory    InvoiceStatusHistory[]
  discountSnapshots InvoiceDiscountSnapshot[]

  @@unique([tenantId, id], map: "invoices_tenant_id_key")
  @@unique([tenantId, invoiceNumber], map: "invoices_tenant_number_key")
  @@index([tenantId, studentId, issueDate, id])
  @@index([tenantId, status, dueDate, id])
  @@map("invoices")
}

model InvoiceItem {
  id            String      @id @db.Char(26)
  tenantId      String      @map("tenant_id") @db.Char(26)
  invoiceId     String      @map("invoice_id") @db.Char(26)
  enrollmentId  String?     @map("enrollment_id") @db.Char(26)
  description   String
  quantity      BigInt      @default(1)
  unitAmountVnd BigInt      @map("unit_amount_vnd")
  amountVnd     BigInt      @map("amount_vnd")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  invoice       Invoice     @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  enrollment    Enrollment? @relation(fields: [tenantId, enrollmentId], references: [tenantId, id])

  @@unique([tenantId, id], map: "invoice_items_tenant_id_key")
  @@index([tenantId, invoiceId, id])
  @@map("invoice_items")
}

model Payment {
  id          String             @id @db.Char(26)
  tenantId    String             @map("tenant_id") @db.Char(26)
  invoiceId   String?            @map("invoice_id") @db.Char(26)
  studentId   String?            @map("student_id") @db.Char(26)
  amountVnd   BigInt             @map("amount_vnd")
  idempotencyKey String?         @map("idempotency_key")
  method      String
  reference   String?
  note        String?
  receivedAt DateTime           @default(now()) @map("received_at") @db.Timestamptz
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  invoice     Invoice?           @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  student     Student?           @relation(fields: [tenantId, studentId], references: [tenantId, id])
  reversals   PaymentReversal[]
  allocations PaymentAllocation[]
  refunds Refund[]

  @@unique([tenantId, id], map: "payments_tenant_id_key")
  @@unique([tenantId, idempotencyKey], map: "payments_tenant_idempotency_key_idx")
  @@index([tenantId, invoiceId, receivedAt, id])
  @@map("payments")
}

model PaymentReversal {
  id             String   @id @db.Char(26)
  tenantId       String   @map("tenant_id") @db.Char(26)
  paymentId      String   @map("payment_id") @db.Char(26)
  idempotencyKey String?  @map("idempotency_key")
  reason         String
  actorUserId    String?  @map("actor_user_id") @db.Char(26)
  actorMembershipId String? @map("actor_membership_id") @db.Char(26)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  payment        Payment  @relation(fields: [tenantId, paymentId], references: [tenantId, id])

  @@unique([tenantId, id], map: "payment_reversals_tenant_id_key")
  @@unique([tenantId, paymentId], map: "payment_reversals_one_per_payment_key")
  @@unique([tenantId, idempotencyKey], map: "payment_reversals_tenant_idempotency_key_idx")
  @@map("payment_reversals")
}

model Discount {
  id String @id @db.Char(26)
  tenantId String @map("tenant_id") @db.Char(26)
  code String
  name String
  kind String
  value BigInt
  maxAmountVnd BigInt? @map("max_amount_vnd")
  status String @default("ACTIVE")
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  enrollmentDiscounts EnrollmentDiscount[]
  invoiceDiscountSnapshots InvoiceDiscountSnapshot[]
  @@unique([tenantId,id], map: "discounts_tenant_id_key")
  @@unique([tenantId,code], map: "discounts_tenant_code_key")
  @@map("discounts")
}

model EnrollmentPricing {
  id String @id @db.Char(26)
  tenantId String @map("tenant_id") @db.Char(26)
  enrollmentId String @map("enrollment_id") @db.Char(26)
  pricingPlanId String? @map("pricing_plan_id") @db.Char(26)
  amountVnd BigInt @map("amount_vnd")
  currency String @default("VND")
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  lockedAt DateTime? @map("locked_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  enrollment Enrollment @relation(fields: [tenantId,enrollmentId], references: [tenantId,id])
  pricingPlan PricingPlan? @relation(fields: [tenantId,pricingPlanId], references: [tenantId,id])
  @@unique([tenantId,id], map: "enrollment_pricing_tenant_id_key")
  @@map("enrollment_pricing")
}

model EnrollmentDiscount {
  id String @id @db.Char(26)
  tenantId String @map("tenant_id") @db.Char(26)
  enrollmentId String @map("enrollment_id") @db.Char(26)
  discountId String @map("discount_id") @db.Char(26)
  amountVnd BigInt @map("amount_vnd")
  appliedAt DateTime @default(now()) @map("applied_at") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  enrollment Enrollment @relation(fields: [tenantId,enrollmentId], references: [tenantId,id])
  discount Discount @relation(fields: [tenantId,discountId], references: [tenantId,id])
  invoiceDiscountSnapshots InvoiceDiscountSnapshot[]
  @@unique([tenantId,id], map: "enrollment_discounts_tenant_id_key")
  @@map("enrollment_discounts")
}

model InvoiceStatusHistory {
  id          String   @id @db.Char(26)
  tenantId    String   @map("tenant_id") @db.Char(26)
  invoiceId   String   @map("invoice_id") @db.Char(26)
  status      String
  effectiveAt DateTime @map("effective_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  invoice     Invoice  @relation(fields: [tenantId, invoiceId], references: [tenantId, id])

  @@unique([tenantId, id], map: "invoice_status_history_tenant_id_key")
  @@index([tenantId, invoiceId, effectiveAt, id])
  @@map("invoice_status_history")
}

model CreditNote {
  id String @id @db.Char(26)
  tenantId String @map("tenant_id") @db.Char(26)
  creditNoteNumber String? @map("credit_note_number")
  invoiceId String @map("invoice_id") @db.Char(26)
  amountVnd BigInt @map("amount_vnd")
  reason String
  status String @default("DRAFT")
  issuedAt DateTime? @map("issued_at") @db.Timestamptz
  idempotencyKey String? @map("idempotency_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  invoice Invoice @relation(fields: [tenantId,invoiceId], references: [tenantId,id])
  voids CreditNoteVoid[]
  @@unique([tenantId,id], map: "credit_notes_tenant_id_key")
  @@unique([tenantId,creditNoteNumber], map: "credit_notes_tenant_number_key")
  @@unique([tenantId,idempotencyKey], map: "credit_notes_tenant_idempotency_key_idx")
  @@map("credit_notes")
}

model CreditNoteVoid {
  id String @id @db.Char(26)
  tenantId String @map("tenant_id") @db.Char(26)
  creditNoteId String @map("credit_note_id") @db.Char(26)
  reason String
  actorUserId String? @map("actor_user_id") @db.Char(26)
  actorMembershipId String? @map("actor_membership_id") @db.Char(26)
  idempotencyKey String @map("idempotency_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  creditNote CreditNote @relation(fields: [tenantId, creditNoteId], references: [tenantId, id])
  @@unique([tenantId,id], map: "credit_note_voids_tenant_id_key")
  @@unique([tenantId,creditNoteId], map: "credit_note_voids_one_per_note_key")
  @@unique([tenantId,idempotencyKey], map: "credit_note_voids_idempotency_key")
  @@map("credit_note_voids")
}

model InvoiceDiscountSnapshot {
  id                   String   @id @db.Char(26)
  tenantId             String   @map("tenant_id") @db.Char(26)
  invoiceId            String   @map("invoice_id") @db.Char(26)
  enrollmentDiscountId String?  @map("enrollment_discount_id") @db.Char(26)
  discountId           String?  @map("discount_id") @db.Char(26)
  code                 String?
  name                 String?
  kind                 String?
  value                BigInt?
  maxAmountVnd         BigInt?  @map("max_amount_vnd")
  amountVnd            BigInt   @map("amount_vnd")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  invoice              Invoice  @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  enrollmentDiscount   EnrollmentDiscount? @relation(fields: [tenantId, enrollmentDiscountId], references: [tenantId, id])
  discount             Discount? @relation(fields: [tenantId, discountId], references: [tenantId, id])

  @@unique([tenantId, id], map: "invoice_discount_snapshots_tenant_id_key")
  @@index([tenantId, invoiceId, id])
  @@map("invoice_discount_snapshots")
}

model PaymentAllocation {
  id String @id @db.Char(26)
  tenantId String @map("tenant_id") @db.Char(26)
  paymentId String @map("payment_id") @db.Char(26)
  invoiceId String @map("invoice_id") @db.Char(26)
  amountVnd BigInt @map("amount_vnd")
  idempotencyKey String? @map("idempotency_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  payment Payment @relation(fields: [tenantId,paymentId], references: [tenantId,id])
  invoice Invoice @relation(fields: [tenantId,invoiceId], references: [tenantId,id])
  refundAllocations RefundAllocation[]
  @@unique([tenantId,id], map: "payment_allocations_tenant_id_key")
  @@unique([tenantId,paymentId,invoiceId,idempotencyKey], map: "payment_allocations_tenant_idempotency_key_idx")
  @@map("payment_allocations")
}

model Refund {
  id String @id @db.Char(26)
  tenantId String @map("tenant_id") @db.Char(26)
  paymentId String @map("payment_id") @db.Char(26)
  amountVnd BigInt @map("amount_vnd")
  reason String
  actorUserId String? @map("actor_user_id") @db.Char(26)
  actorMembershipId String? @map("actor_membership_id") @db.Char(26)
  idempotencyKey String @map("idempotency_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  payment Payment @relation(fields: [tenantId,paymentId], references: [tenantId,id])
  allocations RefundAllocation[]
  @@unique([tenantId,id], map: "refunds_tenant_id_key")
  @@unique([tenantId,paymentId,idempotencyKey], map: "refunds_payment_key")
  @@map("refunds")
}

model RefundAllocation {
  id String @id @db.Char(26)
  tenantId String @map("tenant_id") @db.Char(26)
  refundId String @map("refund_id") @db.Char(26)
  paymentAllocationId String @map("payment_allocation_id") @db.Char(26)
  amountVnd BigInt @map("amount_vnd")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  refund Refund @relation(fields: [tenantId, refundId], references: [tenantId, id])
  paymentAllocation PaymentAllocation @relation(fields: [tenantId, paymentAllocationId], references: [tenantId, id])
  @@unique([tenantId,id], map: "refund_allocations_tenant_id_key")
  @@unique([tenantId,refundId,paymentAllocationId], map: "refund_allocations_unique_key")
  @@index([tenantId,paymentAllocationId,id], map: "refund_allocations_invoice_lookup_idx")
  @@map("refund_allocations")
}

model AuditEvent {
  id                String   @id @db.Char(26)
  tenantId          String   @map("tenant_id") @db.Char(26)
  actorUserId       String?  @map("actor_user_id") @db.Char(26)
  actorMembershipId String?  @map("actor_membership_id") @db.Char(26)
  actorName         String?  @map("actor_name")
  actorEmail        String?  @map("actor_email")
  action            String
  entityType        String   @map("entity_type")
  entityId          String?  @map("entity_id") @db.Char(26)
  before            Json?
  after             Json?
  reason            String?
  requestId         String?  @map("request_id")
  metadata          Json?
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([tenantId, occurredAt, id])
  @@index([tenantId, actorUserId, occurredAt, id])
  @@index([tenantId, action, occurredAt, id])
  @@index([tenantId, entityType, occurredAt, id])
  @@index([tenantId, entityId, occurredAt, id])
  @@map("audit_events")
}
