// Tenant-database schema, applied to every tenant database by
// `pnpm tenant:migrate` (prisma migrate deploy per tenant, see
// src/database/tenant-migrations.ts). Tenant data is queried at runtime
// through raw pg pools (TenantConnectionManager), so no Prisma client is
// generated from this schema.

datasource db {
  provider = "postgresql"
}

model Student {
  id          String       @id @db.Char(26)
  tenantId    String       @map("tenant_id") @db.Char(26)
  code        String
  fullName    String       @map("full_name")
  phone       String?
  email       String?
  dateOfBirth DateTime?    @map("date_of_birth") @db.Date
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]

  @@unique([tenantId, code], map: "students_tenant_id_code_key")
  @@index([tenantId, fullName, id], map: "students_tenant_id_full_name_id_idx")
  @@map("students")
}

model Course {
  id          String   @id @db.Char(26)
  tenantId    String   @map("tenant_id") @db.Char(26)
  code        String
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  classes     Class[]

  @@unique([tenantId, code], map: "courses_tenant_id_code_key")
  @@index([tenantId, name, id], map: "courses_tenant_id_name_id_idx")
  @@map("courses")
}

model Class {
  id          String       @id @db.Char(26)
  tenantId    String       @map("tenant_id") @db.Char(26)
  courseId    String?      @map("course_id") @db.Char(26)
  code        String
  name        String
  description String?
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  course            Course?             @relation(fields: [courseId], references: [id])
  enrollments       Enrollment[]
  schedules         Schedule[]
  attendanceSessions AttendanceSession[]

  @@unique([tenantId, code], map: "classes_tenant_id_code_key")
  @@index([tenantId, name, id], map: "classes_tenant_id_name_id_idx")
  @@index([tenantId, courseId, name, id], map: "classes_tenant_id_course_id_name_id_idx")
  @@map("classes")
}

model Teacher {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  code      String
  name      String
  phone     String?
  email     String?
  note      String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  schedules          Schedule[]
  attendanceSessions AttendanceSession[]

  @@unique([tenantId, code], map: "teachers_tenant_id_code_key")
  @@index([tenantId, name, id], map: "teachers_tenant_id_name_id_idx")
  @@map("teachers")
}

model Enrollment {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  studentId  String   @map("student_id") @db.Char(26)
  classId    String   @map("class_id") @db.Char(26)
  status     String   @default("ACTIVE")
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  student    Student  @relation(fields: [studentId], references: [id])
  class      Class    @relation(fields: [classId], references: [id])

  @@unique([tenantId, studentId, classId], map: "enrollments_tenant_id_student_id_class_id_key")
  @@index([tenantId, classId, enrolledAt, id], map: "enrollments_tenant_id_class_id_enrolled_at_id_idx")
  @@map("enrollments")
}

/// Active duplicates are prevented by the migration's partial unique index, which Prisma cannot model.
model Schedule {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  classId   String   @map("class_id") @db.Char(26)
  teacherId String   @map("teacher_id") @db.Char(26)
  dayOfWeek String   @map("day_of_week")
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)
  room      String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  class              Class               @relation(fields: [classId], references: [id])
  teacher            Teacher             @relation(fields: [teacherId], references: [id])
  attendanceSessions AttendanceSession[]

  @@index([tenantId, classId, dayOfWeek, startTime, id], map: "schedules_tenant_id_class_id_day_of_week_start_time_id_idx")
  @@index([tenantId, teacherId, dayOfWeek, startTime, id], map: "schedules_tenant_id_teacher_id_day_of_week_start_time_id_idx")
  @@map("schedules")
}

/// Schedule/date uniqueness is enforced by the migration's partial unique index, which Prisma cannot model.
model AttendanceSession {
  id          String   @id @db.Char(26)
  tenantId    String   @map("tenant_id") @db.Char(26)
  classId     String   @map("class_id") @db.Char(26)
  scheduleId  String?  @map("schedule_id") @db.Char(26)
  teacherId   String?  @map("teacher_id") @db.Char(26)
  sessionDate DateTime @map("session_date") @db.Date
  startTime   DateTime @map("start_time") @db.Time(0)
  endTime     DateTime @map("end_time") @db.Time(0)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  class       Class    @relation(fields: [classId], references: [id])
  schedule    Schedule? @relation(fields: [scheduleId], references: [id])
  teacher     Teacher? @relation(fields: [teacherId], references: [id])
  records     AttendanceRecord[]

  @@unique([tenantId, classId, sessionDate, startTime, endTime], map: "attendance_sessions_occurrence_key")
  @@index([tenantId, classId, sessionDate, id], map: "attendance_sessions_tenant_id_class_id_session_date_id_idx")
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String            @id @db.Char(26)
  tenantId            String            @map("tenant_id") @db.Char(26)
  attendanceSessionId String            @map("attendance_session_id") @db.Char(26)
  studentId           String            @map("student_id") @db.Char(26)
  status              String            @default("PRESENT")
  note                String?
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id])
  student             Student           @relation(fields: [studentId], references: [id])

  @@unique([tenantId, attendanceSessionId, studentId], map: "attendance_records_session_student_key")
  @@index([tenantId, studentId, id], map: "attendance_records_tenant_id_student_id_id_idx")
  @@map("attendance_records")
}
