{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 0_existing_control_schema",
    "auth:create-owner": "node dist/database/create-owner.js",
    "tenant:create": "node dist/database/create-tenant.js",
    "tenant:migrate": "node dist/database/tenant-migrations.js",
    "dev": "pnpm run prisma:generate && nest start --watch",
    "start:dev": "pnpm run dev",
    "build": "pnpm run prisma:generate && nest build",
    "start:prod": "prisma migrate deploy && node dist/database/tenant-migrations.js && node dist/main.js",
    "test": "pnpm run prisma:generate && vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
